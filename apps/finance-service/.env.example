PORT=3000
# Lokale Postgres uit docker-compose (pnpm db:up)
DATABASE_URL=postgresql://fintrack:fintrack@localhost:5432/fintrack
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optioneel: gratis Demo-key via https://www.coingecko.com/en/api
COINGECKO_API_KEY=
COINGECKO_TIMEOUT_MS=5000
CACHE_TTL_SECONDS=60
HEALTH_UPSTREAM_CACHE_SECONDS=30

PORT=3001
# Zelfde database als finance-service, maar eigen schema (ook voor de migratiehistoriek).
DATABASE_URL=postgresql://fintrack:fintrack@localhost:5432/fintrack?schema=monitoring

# Bewaakte targets
FINANCE_SERVICE_URL=http://localhost:3000
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optioneel: gratis Demo-key via https://www.coingecko.com/en/api
COINGECKO_API_KEY=

POLL_INTERVAL_SECONDS=30
COINGECKO_POLL_INTERVAL_SECONDS=60
CHECK_TIMEOUT_MS=5000
# Aantal opeenvolgende mislukte checks voor er een incident + alert komt.
ALERT_AFTER_FAILURES=2
RETENTION_DAYS=30

# Alerts per mail. Lokaal: Mailpit uit docker-compose (web-UI op http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=FinTrack Monitoring <monitoring@fintrack.local>
# Leeg = alerts worden enkel gelogd.
ALERT_EMAIL_TO=jij@example.com

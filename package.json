{
  "name": "fintrack",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./libs/**\" --filter \"./apps/**\" build",
    "test": "pnpm -r --filter \"./libs/**\" --filter \"./apps/**\" test",
    "lint": "pnpm -r lint",
    "test:e2e": "pnpm --filter @fintrack/e2e test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  }
}
